(function() {
    var preloader = document.getElementById('page-preloader');
    var fill = document.getElementById('loader-fill');
    var perc = document.getElementById('loader-perc');
    var logo = preloader.querySelector('.loader-logo');

    var resetLogoAnimation = function(start) {
        if (!logo) return;
        if (start) {
            logo.classList.add('start-animation');
        } else {
            logo.classList.remove('start-animation');
        }
    };

    // Скрытие прелоадера
    var hidePreloader = function() {
        if (!preloader.classList.contains('done')) {
            if (fill) fill.style.width = '100%';
            if (perc) perc.textContent = '100%';

            setTimeout(function() {
                preloader.classList.add('done');
                preloader.classList.remove('preloader-fading-in');
                
                setTimeout(function() {
                    resetLogoAnimation(false);
                    preloader.style.display = 'none';
                }, 500);
            }, 300);
        }
    };

    // Показ прелоадера
    var startTransition = function(url) {
        if (fill) fill.style.width = '0%';
        if (perc) perc.textContent = '0%';
        
        preloader.style.display = 'flex';
        
        setTimeout(function() {
            preloader.classList.remove('done');
            preloader.classList.add('preloader-fading-in');
        }, 10);
        
        setTimeout(function() {
            window.location.href = url;
        }, 550);
    };

    // Запуск при загрузке НОВОЙ страницы
    resetLogoAnimation(true);

    // Логика реального прогресса
    var resources = document.querySelectorAll('img, script, link[rel="stylesheet"]');
    var total = resources.length;
    var loaded = 0;
    function updateProgress() {
        loaded++;
        var progress = Math.round((loaded / total) * 100);
        if (progress > 100) progress = 100;
        if (fill) fill.style.width = progress + '%';
        if (perc) perc.textContent = progress + '%';
    }
    resources.forEach(function(res) {
        if (res.complete) updateProgress();
        else { res.addEventListener('load', updateProgress); res.addEventListener('error', updateProgress); }
    });

    window.addEventListener('load', hidePreloader);

    document.addEventListener('click', function(e) {
        var anchor = e.target.closest('a');
        if (anchor && anchor.href && anchor.host === window.location.host && 
            !anchor.getAttribute('target') && !anchor.href.includes('#') &&
            !anchor.href.startsWith('tel:') && !anchor.href.startsWith('mailto:') &&
            !e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            startTransition(anchor.href);
        }
    });

    window.addEventListener('pageshow', function(event) {
        if (event.persisted) hidePreloader();
    });

    setTimeout(hidePreloader, 12000);
})();

(function() {
    // Построение вкладок для мега-меню
    function initMegaMenuTabs() {
        const menuContainer = document.querySelector('.sf-nav-full-screen');
        if (!menuContainer) return;

        const contentContainer = menuContainer.querySelector('.sf-nav-full-screen-content');
        if (!contentContainer) return;

        if (menuContainer.querySelector('.mega-menu-tabs')) return;

        const tabsContainer = document.createElement('div');
        tabsContainer.className = 'mega-menu-tabs';

        const lists = menuContainer.querySelectorAll('.sf-nav-full-screen-list');
        lists.forEach((list, index) => {
            const headerLink = list.querySelector('.sf-nav-full-screen-list-header a');
            if (!headerLink) return;

            const tabTitle = headerLink.textContent.trim();
            const tab = document.createElement('button');
            tab.className = 'mega-menu-tab';
            tab.textContent = tabTitle;
            tab.dataset.targetIndex = index;

            if (headerLink.classList.contains('active') || list.querySelector('.active') || headerLink.classList.contains('blackout')) {
                tab.classList.add('is-active');
                list.classList.add('is-active-list');
            }

            tab.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                tabsContainer.querySelectorAll('.mega-menu-tab').forEach(t => t.classList.remove('is-active'));
                lists.forEach(l => l.classList.remove('is-active-list'));

                tab.classList.add('is-active');
                list.classList.add('is-active-list');

                updateScrollArrows();
            });

            tabsContainer.appendChild(tab);
        });

        const activeTab = tabsContainer.querySelector('.mega-menu-tab.is-active');
        if (!activeTab && tabsContainer.children.length > 0) {
            const firstTab = tabsContainer.children[0];
            firstTab.classList.add('is-active');
            lists[0].classList.add('is-active-list');
        }

        const tabsWrapper = document.createElement('div');
        tabsWrapper.className = 'mega-menu-tabs-wrapper';
        tabsWrapper.appendChild(tabsContainer);

        // Создаем реальные кликабельные кнопки-стрелочки для ПК и мобильных версий
        const leftArrow = document.createElement('button');
        leftArrow.className = 'mega-menu-scroll-arrow left-arrow';
        leftArrow.innerHTML = '←';
        leftArrow.setAttribute('type', 'button');

        const rightArrow = document.createElement('button');
        rightArrow.className = 'mega-menu-scroll-arrow right-arrow';
        rightArrow.innerHTML = '→';
        rightArrow.setAttribute('type', 'button');

        leftArrow.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            tabsContainer.scrollBy({ left: -200, behavior: 'smooth' });
        });

        rightArrow.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            tabsContainer.scrollBy({ left: 200, behavior: 'smooth' });
        });

        tabsWrapper.appendChild(leftArrow);
        tabsWrapper.appendChild(rightArrow);

        contentContainer.insertBefore(tabsWrapper, contentContainer.firstChild);

        function updateScrollArrows() {
            // Если вкладки не влезают по ширине, сбрасываем выравнивание по центру, чтобы избежать обрезки слева на малых масштабах ПК
            const isScrollable = tabsContainer.scrollWidth > tabsContainer.clientWidth;
            if (isScrollable) {
                tabsContainer.classList.add('is-scrollable');
            } else {
                tabsContainer.classList.remove('is-scrollable');
            }

            if (tabsContainer.scrollLeft > 5) {
                tabsWrapper.classList.add('has-left-scroll');
            } else {
                tabsWrapper.classList.remove('has-left-scroll');
            }

            const canScrollRight = (tabsContainer.scrollWidth - tabsContainer.clientWidth - tabsContainer.scrollLeft) > 5;
            if (canScrollRight) {
                tabsWrapper.classList.add('has-right-scroll');
            } else {
                tabsWrapper.classList.remove('has-right-scroll');
            }
        }

        tabsContainer.addEventListener('scroll', updateScrollArrows);
        window.addEventListener('resize', updateScrollArrows);
        setTimeout(updateScrollArrows, 150);
    }

    // Рендер элементов мобильного поиска и мобильного оверлея
