    let menuWatchInitialized = false;
    let styleObserver; // Глобальный наблюдатель изменений стилей html и body

    // Функция очистки инлайнового overflow: hidden у тегов html и body
    function cleanOverflowStyles() {
        if (!styleObserver) return;
        
        styleObserver.disconnect(); // Временно отключаем слежение

        const html = document.documentElement;
        const body = document.body;

        if (html.style.overflow === 'hidden' || html.style.overflowY === 'hidden') {
            html.style.removeProperty('overflow');
            html.style.removeProperty('overflow-y');
        }
        if (body.style.overflow === 'hidden' || body.style.overflowY === 'hidden') {
            body.style.removeProperty('overflow');
            body.style.removeProperty('overflow-y');
        }

        // Переподключаем слежение
        styleObserver.observe(html, { attributes: true, attributeFilter: ['style'] });
        styleObserver.observe(body, { attributes: true, attributeFilter: ['style'] });
    }

    // Вспомогательные функции переключения классов хедера и бургера
    function openMenu() {
        const menu = document.querySelector('.sf-nav-full-screen');
        const header = document.querySelector('.modern-header-flat');
        const burgers = document.querySelectorAll('.btn-full-screen');
        if (!menu || !header) return;

        menu.classList.add('is-open'); 
        header.classList.add('menu-open');
        burgers.forEach(b => b.classList.add('is-active'));
        
        cleanOverflowStyles();
    }

    function closeMenu() {
        const menu = document.querySelector('.sf-nav-full-screen');
        const header = document.querySelector('.modern-header-flat');
        const burgers = document.querySelectorAll('.btn-full-screen');
        if (!menu || !header) return;

        menu.classList.remove('is-open'); 
        header.classList.remove('menu-open');
        burgers.forEach(b => b.classList.remove('is-active'));
        
        cleanOverflowStyles();
    }

    // Блокируем прокрутку фона (body), но разрешаем прокрутку внутри самого мега-меню
    function preventBackgroundScroll(e) {
        const menu = document.querySelector('.sf-nav-full-screen');
        if (menu && menu.classList.contains('is-open')) {
            // Если событие прокрутки происходит внутри мега-меню, разрешаем его
            if (e.target.closest('.sf-nav-full-screen')) {
                return;
            }
            // В противном случае блокируем прокрутку страницы
            e.preventDefault();
        }
    }

    // Блокируем прокрутку фона на ПК и мобильных, НЕ скрывая сам скроллбар (исключает "прыжки" контента)
    document.addEventListener('wheel', preventBackgroundScroll, { passive: false });
    document.addEventListener('touchmove', preventBackgroundScroll, { passive: false });

    // Следим за открытием и закрытием мега-меню (всех страниц)
    function watchAllPagesMenu() {
        const menu = document.querySelector('.sf-nav-full-screen');
        const header = document.querySelector('.modern-header-flat');
        const burgers = document.querySelectorAll('.btn-full-screen');
        if (!menu || !header || burgers.length === 0) return;

        menu.style.display = 'block';
        menu.style.borderRadius = '0px';

        // Инициализируем открытие только ОДИН раз при первом появлении конкретного DOM-узла.
        // Это предотвращает повторный вызов MutationObserver при попытке закрыть меню.
        if (!menu.hasAttribute('data-first-load-processed')) {
            menu.setAttribute('data-first-load-processed', 'true');
            if (!menu.classList.contains('is-open')) {
                openMenu();
            }
        }
    }

    // ЕДИНЫЙ ОБРАБОТЧИК ДЛЯ КЛИКОВ И КАСАНИЙ С ЗАЩИТОЙ ОТ ДВОЙНОГО СРАБАТЫВАНИЯ (ДЕБАУНСЕР)
    function handleBurgerToggle(e) {
        const burger = e.target.closest('.btn-full-screen');
        if (burger) {
            const currentMenu = document.querySelector('.sf-nav-full-screen');
            const now = Date.now();
            
            // Если меню еще нет в DOM (первый клик/касание) — позволяем Simai нативно
            // внедрить его в структуру страницы. Не вызываем preventDefault!
            if (!currentMenu) {
                // Помечаем, что этот жест/касание инициализирует меню
                burger.setAttribute('data-initializing-menu', now);
                return;
            }

            // Если меню только что инициализировалось в этой же сессии (в пределах 500 мс),
            // мы не должны закрывать его в последующих событиях жеста (touchend, click)
            const initializingTime = burger.getAttribute('data-initializing-menu');
            if (initializingTime && (now - parseInt(initializingTime) < 500)) {
                if (e.type === 'click') {
                    burger.removeAttribute('data-initializing-menu');
                }
                return; // Игнорируем это событие, давая меню открыться и остаться открытым
            }

            // Перехватываем управление у нативных обработчиков для последующих открытий/закрытий
            e.preventDefault();
            e.stopImmediatePropagation();
            e.stopPropagation();

            // Временная метка последнего сенсорного взаимодействия для блокировки кликов
            if (e.type === 'touchstart' || e.type === 'touchend') {
                burger.setAttribute('data-last-touch', now);
            } else if (e.type === 'click') {
                const lastTouch = burger.getAttribute('data-last-touch');
                if (lastTouch && (now - parseInt(lastTouch) < 500)) {
                    return; // Игнорируем симулированный браузером клик на телефоне
                }
            }

            // Исключаем дребезг между touchstart и touchend в рамках одного касания
            const lastProcessed = burger.getAttribute('data-last-processed');
            if (lastProcessed && (now - parseInt(lastProcessed) < 250)) {
                return; 
            }
            burger.setAttribute('data-last-processed', now);

            if (currentMenu.classList.contains('is-open')) {
                closeMenu();
            } else {
                openMenu();
            }
        }
    }

    // Регистрируем перехватчики в фазе захвата (true) на все типы взаимодействия
    document.addEventListener('click', handleBurgerToggle, true);
    document.addEventListener('touchstart', handleBurgerToggle, { capture: true, passive: false });
    document.addEventListener('touchend', handleBurgerToggle, { capture: true, passive: false });

    // Перехватчик кнопки закрытия
    document.addEventListener('click', function(e) {
        const closeBtn = e.target.closest('.sf-close');
        if (closeBtn) {
            const currentMenu = document.querySelector('.sf-nav-full-screen');
            if (currentMenu) {
                e.preventDefault();
                e.stopImmediatePropagation();
                e.stopPropagation();
                closeMenu();
            }
        }
    }, true);

    function runInit() {
        renderMobileSearchElements();
        initMegaMenuTabs();
        watchAllPagesMenu();

        // Защищаем элементы от сброса через Composite / Lazy Load Битрикса
        const observer = new MutationObserver(function() {
            renderMobileSearchElements();
            initMegaMenuTabs();
            watchAllPagesMenu();
            cleanOverflowStyles();
        });
        observer.observe(document.body, { childList: true, subtree: true });

        // Создаем и подключаем наблюдатель изменений атрибутов style у html и body
        styleObserver = new MutationObserver(cleanOverflowStyles);
        styleObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['style'] });
        styleObserver.observe(document.body, { attributes: true, attributeFilter: ['style'] });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runInit);
    } else {
        runInit();
    }
})();
