            // 4. Форматирование контактной информации на лету
            formatContactDetails();

            // 5. Перенос отформатированного адреса в подвальный плейсхолдер
            const addressToMove = document.querySelector('[data-address-processed="true"]');
            const addressPlaceholder = document.querySelector('.custom-footer-address-placeholder');
            if (addressToMove && addressPlaceholder && !addressPlaceholder.contains(addressToMove)) {
                addressPlaceholder.appendChild(addressToMove);
            }
            
        } catch (e) {
            console.error('Ошибка в работе скрипта перестроения футера: ', e);
        } finally {
            isMutating = false;
        }
    }
    
    // Запуск при стартовой загрузке страницы
    moveFooterElements();
    
    // Поддержка корректной работы при динамической подгрузке Bitrix Composite / AJAX Lazy Load
    const obs = new MutationObserver(moveFooterElements);
    obs.observe(document.body, { childList: true, subtree: true });
})();
</script></body>
